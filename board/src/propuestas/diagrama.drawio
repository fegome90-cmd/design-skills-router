<mxfile host="app.diagrams.net" modified="2026-11-17T00:00:00Z" agent="Design Skills Router / proposals research" version="24.7.17" type="device"><diagram id="change-06" name="Cambios propuestos · 6 capas"><mxGraphModel dx="1848" dy="1066" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1920" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="layer-encuadre" value="00 · Encuadre y autoridad" parent="0" visible="1" /><mxCell id="C01" value="C01 · Contratos de elegibilidad ≠ permisos de ejecución&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 · F1 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Separar lectura, selección, propuesta y acción externa en cuatro decisiones comprobables.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-encuadre"><mxGeometry x="90" y="85" width="620" height="120" as="geometry" /></mxCell><mxCell id="C02" value="C02 · Modo, asistencia y permiso son ejes independientes&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 · F1 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Una auditoría puede ser phase_auto y seguir siendo estrictamente de solo lectura.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-encuadre"><mxGeometry x="810" y="85" width="620" height="120" as="geometry" /></mxCell><mxCell id="C03" value="C03 · Evitar dobles orquestadores y rutas fuera de ámbito&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 · F1 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;No permitir que un wrapper externo sustituya G0; deploy, nativo y slides siguen independientes.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-encuadre"><mxGeometry x="1530" y="85" width="620" height="120" as="geometry" /></mxCell><mxCell id="layer-fundaciones" value="01 · Investigación y fuentes" parent="0" visible="1" /><mxCell id="C04" value="C04 · Fijar fuentes y vetting antes de admitir&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 · F2 · BLOQUEO DE FUENTE&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Los enlaces blob/main no bastan para reproducir una skill ni revisar sus dependencias.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-fundaciones"><mxGeometry x="90" y="370" width="620" height="120" as="geometry" /></mxCell><mxCell id="C05" value="C05 · Recuperación por dominio y tres referencias cuando aplique&lt;br/&gt;&lt;font color='#5c5a65'&gt;G1 · F2 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La comparación visual informa G1 sin reemplazar la identidad del proyecto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#f8f7ff;strokeColor=#5963a6;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-fundaciones"><mxGeometry x="810" y="370" width="620" height="120" as="geometry" /></mxCell><mxCell id="layer-sistema" value="02 · Sistema visual" parent="0" visible="1" /><mxCell id="C06" value="C06 · Acotar los 23 comandos y workflows estéticos&lt;br/&gt;&lt;font color='#5c5a65'&gt;G1 · F2 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Impeccable, Taste, Hallmark y Anthropic asesoran; la decisión sigue en G1–G7.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-sistema"><mxGeometry x="90" y="655" width="620" height="120" as="geometry" /></mxCell><mxCell id="C07" value="C07 · Movimiento: decisión → construcción → revisión&lt;br/&gt;&lt;font color='#5c5a65'&gt;G7 · F3 · REUBICACIÓN&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La capa de QA no puede contener automáticamente implementadores de movimiento.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-sistema"><mxGeometry x="810" y="655" width="620" height="120" as="geometry" /></mxCell><mxCell id="C08" value="C08 · Web móvil no equivale a aplicación nativa&lt;br/&gt;&lt;font color='#5c5a65'&gt;G5 / G7 · F3 · REUBICACIÓN&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La semántica de la skill manda, no la palabra “native” de su nombre.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-sistema"><mxGeometry x="1530" y="655" width="620" height="120" as="geometry" /></mxCell><mxCell id="C09" value="C09 · Demo ilustrada y hero ≠ UI funcional&lt;br/&gt;&lt;font color='#5c5a65'&gt;G1 · F3 · RUTA CONDICIONAL&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Stageshow y banner-design producen escenas de producto; no certifican comportamiento real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#f8f7ff;strokeColor=#5963a6;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-sistema"><mxGeometry x="90" y="791" width="620" height="120" as="geometry" /></mxCell><mxCell id="layer-componentes" value="03 · Componentes y adopción" parent="0" visible="1" /><mxCell id="C10" value="C10 · Un contrato ADOPT para cada requisito atómico&lt;br/&gt;&lt;font color='#5c5a65'&gt;G6 · F3 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Una sugerencia de biblioteca no constituye decisión de adopción.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-componentes"><mxGeometry x="90" y="940" width="620" height="120" as="geometry" /></mxCell><mxCell id="C11" value="C11 · Preservar Base UI y APIs existentes&lt;br/&gt;&lt;font color='#5c5a65'&gt;G6 · F3 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La tecnología del proyecto es una restricción, no un gusto de la skill.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#f8f7ff;strokeColor=#5963a6;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-componentes"><mxGeometry x="810" y="940" width="620" height="120" as="geometry" /></mxCell><mxCell id="layer-validacion" value="04 · Validación verificable" parent="0" visible="1" /><mxCell id="C12" value="C12 · Pruebas adversariales sin escribir en producción&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 / G7 · F4 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Separar inspección, prueba sintética de sandbox y corrección real.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-validacion"><mxGeometry x="90" y="1225" width="620" height="120" as="geometry" /></mxCell><mxCell id="C13" value="C13 · Guías dinámicas y pruebas negativas reproducibles&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 · F4 · PROPUESTO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La URL de reglas vivas necesita snapshot antes de comparar resultados.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-validacion"><mxGeometry x="810" y="1225" width="620" height="120" as="geometry" /></mxCell><mxCell id="layer-aprendizaje" value="05 · Gates y aprendizaje" parent="0" visible="1" /><mxCell id="C14" value="C14 · Aprendizaje propuesto, nunca autoescritura&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 / G1–G7 · F4 · GATE HUMANO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;Learn Taste necesita feedback real y aceptación literal de cada regla.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-aprendizaje"><mxGeometry x="90" y="1510" width="620" height="120" as="geometry" /></mxCell><mxCell id="C15" value="C15 · Baseline nuevo, release separado y rollback&lt;br/&gt;&lt;font color='#5c5a65'&gt;G0 / host · F4 · GATE HUMANO&lt;/font&gt;&lt;br/&gt;&lt;font color='#515b76'&gt;La pizarra y los contratos candidatos no son una publicación del plugin.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=18;fillColor=#fef7f3;strokeColor=#b85849;strokeWidth=1.7;dashed=1;dashPattern=6 4;fontSize=15;fontColor=#253049;shadow=0;" vertex="1" parent="layer-aprendizaje"><mxGeometry x="810" y="1510" width="620" height="120" as="geometry" /></mxCell><mxCell id="C01-to-C02" value="depende de" style="edgeStyle=ortho