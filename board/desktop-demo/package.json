{
  "name": "design-router-desktop-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/dependency-notices.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "playwright test",
    "lint": "oxlint src tests scripts playwright.config.ts vite.config.ts",
    "check:design": "node scripts/check-design.mjs",
    "check:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.24.0",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "impeccable": "4.9.2",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8"
  }
}
