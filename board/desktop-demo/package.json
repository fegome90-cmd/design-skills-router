{
  "name": "design-router-desktop-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && npm run build:standalone && node scripts/dependency-notices.mjs",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "test": "npm run build:standalone && playwright test",
    "test:unit": "vitest run",
    "lint": "oxlint src tests scripts playwright.config.ts vite.config.ts",
    "check:design": "node scripts/check-design.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "build:standalone": "vite build --mode standalone --outDir dist/standalone"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.12",
    "@ui-sdk/react": "0.1.0-beta.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cytoscape": "3.35.0",
    "lucide-react": "1.75.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.24",
    "@playwright/test": "1.57.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "impeccable": "4.9.2",
    "jsdom": "31.0.1",
    "oxlint": "1.94.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.1"
  }
}
